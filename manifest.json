{
  "manifest_version": 3,
  "name": "Security Header Checker",
  "version": "4.0.0",
  "description": "Checks security headers, cookies, and risk level for the current page.",
  "permissions": ["activeTab", "tabs", "webRequest", "cookies"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
